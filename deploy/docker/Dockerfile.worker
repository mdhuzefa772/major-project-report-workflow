FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY apps/worker/pyproject.toml /app/apps/worker/pyproject.toml
RUN cd /app/apps/worker && uv pip install --system --no-cache .

COPY apps/worker/src /app/apps/worker/src

ENV PYTHONPATH=/app/apps/worker/src \
    PYTHONUNBUFFERED=1

CMD ["python", "-m", "worker.entrypoints.worker"]
